{
	"name": "multi-tenant",
	"version": "0.1.0",
	"private": true,
	"packageManager": "npm@10.9.3",
	"scripts": {
		"dev": "next dev",
		"dev:workflow": "set WORKFLOW_DEV_ENABLED=1&& next dev",
		"build": "next build --turbopack",
		"start": "next start",
		"lint": "node scripts/check-ui-contract.mjs && eslint",
		"backfill:demo-template": "node scripts/backfill-demo-template.mjs",
		"seed:demo-tenant": "node scripts/bootstrap-demo-tenant.mjs",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck:tests": "tsc --project tsconfig.tests.json",
		"test:e2e": "node scripts/test-integration.mjs",
		"test:e2e:public": "node scripts/test-integration.mjs --public",
		"test:e2e:ui": "node scripts/test-integration.mjs --ui",
		"test:permissions:migration": "node scripts/test-integration.mjs tests/e2e/integration/permission-migration.spec.ts",
		"test:document-generation:runtime": "node scripts/check-document-generation-state.mjs",
		"video:studio": "remotion studio remotion/index.ts",
		"video:render:sintesis": "remotion render remotion/index.ts SintesisCommercial out/sintesis-commercial.mp4 --codec=h264 --crf=18",
		"video:render:saas-showcase": "remotion render remotion/index.ts SintesisSaasShowcase out/sintesis-saas-showcase.mp4 --codec=h264 --crf=18",
		"video:render:usecases": "remotion render remotion/index.ts SintesisUseCases out/sintesis-usecases.mp4 --codec=h264 --crf=18",
		"supabase:install": "npm pkg set scripts._tmp= && npm run _tmp || true && del /q /f NUL 2> NUL",
		"supabase:version": "supabase --version",
		"supabase:start": "supabase start",
		"supabase:stop": "supabase stop",
		"supabase:status": "supabase status",
		"supabase:link": "supabase link --project-ref local",
		"db:push": "supabase db push",
		"db:push:remote": "supabase db push --remote",
		"db:reset": "supabase db reset",
		"clone:prod-to-local": "powershell -ExecutionPolicy Bypass -File scripts/clone-prod-to-local.ps1",
		"verify:folder-move": "node scripts/verify-folder-move.mjs",
		"recovery:verify": "node scripts/recovery/verify-recovery-set.mjs",
		"storybook": "storybook dev -p 6006 --no-open",
		"build-storybook": "storybook build",
		"storybook:preview": "node scripts/serve-storybook.mjs",
		"test:storybook": "node scripts/check-storybook.mjs",
		"typecheck:storybook": "tsc --project .storybook/tsconfig.json",
		"check:ui": "node scripts/check-ui-contract.mjs",
		"typecheck:ui": "tsc --project tsconfig.ui.json",
		"portfolio:dev": "vite --config portfolio-guide/vite.config.ts",
		"portfolio:build": "vite build --config portfolio-guide/vite.config.ts",
		"portfolio:preview": "vite preview --config portfolio-guide/vite.config.ts",
		"portfolio:typecheck": "tsc --project portfolio-guide/tsconfig.json",
		"portfolio:capture": "node portfolio-guide/check.mjs",
		"portfolio:check": "node portfolio-guide/interactions.mjs && node portfolio-guide/journey.mjs && node portfolio-guide/operations-check.mjs"
	},
	"dependencies": {
		"@ai-sdk/google": "^3.0.23",
		"@ai-sdk/openai": "^0.0.50",
		"@dnd-kit/core": "6.3.1",
		"@dnd-kit/modifiers": "9.0.0",
		"@dnd-kit/sortable": "10.0.0",
		"@dnd-kit/utilities": "3.2.2",
		"@radix-ui/react-accordion": "^1.2.12",
		"@radix-ui/react-alert-dialog": "^1.1.15",
		"@radix-ui/react-avatar": "^1.1.11",
		"@radix-ui/react-checkbox": "^1.3.3",
		"@radix-ui/react-collapsible": "^1.1.12",
		"@radix-ui/react-context-menu": "^2.2.16",
		"@radix-ui/react-dialog": "^1.1.15",
		"@radix-ui/react-dropdown-menu": "^2.1.16",
		"@radix-ui/react-hover-card": "^1.1.15",
		"@radix-ui/react-icons": "1.3.2",
		"@radix-ui/react-label": "^2.1.8",
		"@radix-ui/react-popover": "^1.1.15",
		"@radix-ui/react-radio-group": "^1.3.8",
		"@radix-ui/react-scroll-area": "^1.2.10",
		"@radix-ui/react-select": "^2.2.6",
		"@radix-ui/react-separator": "^1.1.8",
		"@radix-ui/react-slot": "^1.2.4",
		"@radix-ui/react-switch": "^1.2.6",
		"@radix-ui/react-tabs": "^1.1.13",
		"@radix-ui/react-tooltip": "^1.2.8",
		"@react-three/drei": "^10.7.7",
		"@react-three/fiber": "^9.4.2",
		"@react-three/postprocessing": "^3.0.4",
		"@remixicon/react": "^4.6.0",
		"@sentry/nextjs": "^10.29.0",
		"@sparticuz/chromium": "^143.0.0",
		"@supabase/ssr": "^0.5.2",
		"@supabase/supabase-js": "^2.74.0",
		"@tabler/icons-react": "^3.36.0",
		"@tanstack/react-form": "^1.23.8",
		"@tanstack/react-query": "^5.59.20",
		"@tanstack/react-table": "^8.21.3",
		"@tanstack/react-virtual": "^3.13.12",
		"@tanstack/zod-form-adapter": "^0.42.1",
		"@upstash/ratelimit": "^2.0.7",
		"@upstash/redis": "^1.35.6",
		"@vercel/analytics": "^1.5.0",
		"@vercel/speed-insights": "^1.3.1",
		"@xyflow/react": "^12.10.2",
		"ai": "^3.4.33",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"date-fns": "^4.1.0",
		"framer-motion": "^12.23.24",
		"jszip": "^3.10.1",
		"lucide-react": "^0.545.0",
		"mammoth": "^1.11.0",
		"motion": "^12.23.24",
		"next": "^16.2.6",
		"next-themes": "^0.4.6",
		"papaparse": "^5.4.1",
		"pdf-parse": "^1.1.1",
		"pdfjs-dist": "5.4.296",
		"postprocessing": "^6.38.2",
		"puppeteer-core": "^24.34.0",
		"react": "19.2.0",
		"react-day-picker": "^9.11.1",
		"react-dom": "19.2.0",
		"react-grid-layout": "^2.2.3",
		"react-pdf": "^10.2.0",
		"react-zoom-pan-pinch": "^3.7.0",
		"recharts": "^2.15.4",
		"resend": "^4.0.0",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.3.1",
		"three": "^0.182.0",
		"undici": "6.22.0",
		"workflow": "^4.0.1-beta.50",
		"xlsx": "^0.18.5",
		"zod": "^3.25.0"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3",
		"@playwright/test": "^1.58.2",
		"@remotion/cli": "4.0.469",
		"@storybook/addon-docs": "^10.6.0",
		"@storybook/nextjs-vite": "^10.6.0",
		"@tailwindcss/postcss": "^4",
		"@types/node": "^20",
		"@types/papaparse": "^5.3.16",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@types/three": "^0.182.0",
		"babel-plugin-react-compiler": "^1.0.0",
		"eslint": "^9",
		"eslint-config-next": "16.2.6",
		"puppeteer": "^24.34.0",
		"react-doctor": "^0.0.17",
		"remotion": "4.0.469",
		"storybook": "^10.6.0",
		"supabase": "^2.98.2",
		"tailwindcss": "^4",
		"tar": "^7.5.2",
		"tw-animate-css": "^1.4.0",
		"typescript": "5.9.3",
		"vite": "7.2.4",
		"vite-tsconfig-paths": "^5.1.4",
		"vitest": "^4.0.14"
	},
	"overrides": {
		"@supabase/node-fetch": "npm:node-fetch@^2.6.7"
	}
}
